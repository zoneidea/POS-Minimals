SUPABASE_URL=https://jibqgpfzmaqsjclbuaxn.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_DB_PASSWORD=your-database-password
DATABASE_URL=postgresql://postgres.jibqgpfzmaqsjclbuaxn:YOUR-PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=prod-ca-2021.crt

# Public Auth configuration only; never prefix database credentials with VITE_
VITE_SUPABASE_URL=https://jibqgpfzmaqsjclbuaxn.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only: required 32-byte hex key for encrypted sale identity snapshots.
# Generate once per environment; securely back it up with the database. Never use VITE_.
SALE_SNAPSHOT_KEY=

# Server-only optional Auth Admin credential for staff email invitations. Never use VITE_.
SUPABASE_SECRET_KEY=
# Must match a Supabase Auth allowed redirect origin; no trailing paths.
APP_PUBLIC_URL=http://127.0.0.1:5173

# Server-only ReservePay merchant contact API bearer key.
RESERVEPAY_API_KEY=

# Optional public Google Search Console HTML-tag verification (no value until supplied).
GOOGLE_SITE_VERIFICATION=

# Optional server-only shared cache for store settings and categories (read/write token).
# Never prefix with VITE_. Remove both values to return to Node cache.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional stable namespace; production/preview/local are separated automatically.
UPSTASH_CACHE_NAMESPACE=
