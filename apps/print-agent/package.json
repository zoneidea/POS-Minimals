{
  "name": "@pos/print-agent",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test src/*.check.mjs",
    "package:mac": "electron-builder --mac dmg",
    "package:win": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "com.zoneidea.pos.printagent",
    "productName": "POS Print Agent",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**",
      "!src/*.check.mjs",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "identity": null,
      "artifactName": "POS-Print-Agent-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "artifactName": "POS-Print-Agent-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "electronVersion": "44.7.2"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "^26.15.3"
  },
  "description": "Local receipt printing companion for POS Minimal",
  "author": "ZONE-IDEA INNOVATION CO.,LTD."
}
