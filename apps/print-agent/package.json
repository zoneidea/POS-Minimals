{
  "name": "@pos/print-agent",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test src/*.check.mjs",
    "package:mac": "electron-builder --mac dmg",
    "package:win": "electron-builder --win nsis --x64",
    "test:electron": "electron src/receipt.smoke.cjs && electron src/customer-display.smoke.cjs && electron src/tray.smoke.cjs && electron src/fx-display.smoke.cjs"
  },
  "build": {
    "appId": "com.zoneidea.pos.printagent",
    "productName": "posjung-agent",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**",
      "!src/*.check.mjs",
      "package.json",
      "!src/*.smoke.cjs"
    ],
    "mac": {
      "target": "dmg",
      "identity": null,
      "artifactName": "posjung-agent-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "artifactName": "posjung-agent-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "electronVersion": "44.7.2"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "^26.15.3"
  },
  "description": "Local receipt printing companion for POSJung",
  "author": "ZONE-IDEA INNOVATION CO.,LTD."
}
