{
  "name": "pos-minimals",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @pos/api",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present",
    "contracts:generate": "openapi-typescript contracts/openapi.yaml -o packages/contracts/src/generated.ts",
    "db:migrate": "tsx --env-file=.env.local scripts/db-migrate.ts",
    "test:db": "vitest run tests/identity-db.test.ts",
    "dev:web": "npm run dev -w @pos/web"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "openapi-typescript": "^7.13.0",
    "pg": "^8.23.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
