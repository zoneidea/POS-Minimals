{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["syd1"],
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/index.ts": { "maxDuration": 30 }
  },
  "routes": [
    { "src": "^/api(?:/.*)?$", "dest": "/api/index" },
    { "handle": "filesystem" },
    { "src": "^/(dashboard|pos|tables|sales|inventory|categories|settings|users|reports(?:/(?:gateway|coupons))?|audits|account|marketplace|coupons|forgot-password|reset-password|join)/?$", "dest": "/internal/$1.html", "headers": { "X-Robots-Tag": "noindex, nofollow" } },
    { "src": "^/line/published/?$", "dest": "/line/published/index.html", "headers": { "X-Robots-Tag": "noindex, nofollow" } },
    { "src": "^/line/?$", "dest": "/line/index.html", "headers": { "X-Robots-Tag": "noindex, nofollow" } },
    { "src": "^/order/?$", "dest": "/guest-order.html", "headers": {"X-Robots-Tag":"noindex, nofollow","Cache-Control":"no-store","Referrer-Policy":"no-referrer"} },
    { "src": "/.*", "dest": "/app.html", "headers": { "X-Robots-Tag": "noindex, nofollow" } }
  ]
}
