{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["syd1"],
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/index.ts": { "maxDuration": 30 }
  },
  "routes": [
    { "src": "^/api(?:/.*)?$", "dest": "/api/index" },
    { "handle": "filesystem" },
    { "src": "^/(dashboard|pos|sales|inventory|categories|settings|users|reports(?:/gateway)?|audits|account|marketplace|forgot-password|reset-password|join)/?$", "dest": "/internal/$1.html", "headers": { "X-Robots-Tag": "noindex, nofollow" } },
    { "src": "/.*", "dest": "/app.html", "headers": { "X-Robots-Tag": "noindex, nofollow" } }
  ]
}
